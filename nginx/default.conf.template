server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # wasm + binary terrain data
  types {
    application/wasm wasm;
    application/octet-stream bin;
  }
  include /etc/nginx/mime.types;

  gzip on;
  gzip_types text/plain text/css application/javascript application/json application/wasm application/octet-stream image/svg+xml;
  gzip_min_length 1024;

  # hashed assets: cache hard; data + index: revalidate
  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; try_files $uri =404; }
  location /data/   { add_header Cache-Control "public, max-age=3600"; try_files $uri =404; }
  location / { try_files $uri $uri/ /index.html; add_header Cache-Control "no-cache"; }
}
